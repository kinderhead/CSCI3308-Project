{
	"name": "projectsourcecode",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "npm install && vite dev --port 3000 --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "mocha --timeout 10000 \"test/**/*.spec.cjs\"",
		"dev:test": "vite dev --host 0.0.0.0 --port 3000"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/mocha": "^10.0.10",
		"@types/qs": "^6.15.1",
		"bootstrap": "^5.3.8",
		"chai": "4.5.0",
		"chai-http": "4.4.0",
		"mocha": "10.8.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"axios": "^1.21.1",
		"bcryptjs": "^3.0.3",
		"pg-promise": "^12.7.1",
		"qs": "^6.17.1"
	}
}
