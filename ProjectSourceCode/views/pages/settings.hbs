<div class="container ml-3">
    <h1>Settings</h1>
    <form action="/setInfo" method="POST">
    <div class="row mt-3">
        <div class="col">
            <label for="name">Name:</label>
        </div>
        <div class="col">
            <input type="text" id="name" name="name">
        </div>
    </div>
    <div class="row mt-3">
        <div class="col">
            <label for="email">Email:</label>
        </div>
        <div class="col">
            <input type="text" id="email" name="email">
        </div>
    </div>
    <div class="row mt-3">
        <div class="col">
            <label for="password">Password:</label>
        </div>
        <div class="col">
            <input type="text" id="password" name="password">
        </div>
    </div>
    <div class="row mt-5">
        <div class="col">
            <label for="storeLoc">Store Location:</label>
        </div>
        <div class="col">
            <input type="text" id="storeLoc" name="storeLoc">
        </div>
    </div>
    <button type="button" class="btn btn-primary" onclick="changeSettings()">
        Update Settings
    </button>
    </form>
</div>